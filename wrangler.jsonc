{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stk-design",
  "compatibility_date": "2026-10-23",
  "observability": { "enabled": true },
  // Код воркера потрібен лише для динамічного /sitemap.xml (з кейсів Sanity).
  "main": "src/index.js",
  "assets": {
    "binding": "ASSETS",
    // Воркер запускається тільки для цих шляхів; решту Cloudflare віддає
    // напряму зі статики (швидше й не витрачає ліміт запитів воркера).
    "run_worker_first": ["/sitemap.xml"],
    // Сайт статичний: віддаємо файли з кореня репозиторію.
    // Що НЕ публікувати — у .assetsignore (насамперед .git).
    "directory": ".",
    // /projects → projects.html, /projects.html → 307 на /projects
    "html_handling": "auto-trailing-slash",
    // Невідома адреса → найближчий 404.html (/en/... → /en/404.html)
    "not_found_handling": "404-page"
  }
}
